# Mainline Intelligence mailing list (welcome mail from no-reply@…)
# Set these on Cloud Run service pyxaiapi, or in a gitignored repo-root .env
#
# iCloud+ custom domain (pixelplaceofficial.com):
#   Host smtp.mail.me.com · Port 587 · User = primary @icloud.com
#   Pass = Apple app-specific password (appleid.apple.com)
#   From = no-reply@pixelplaceofficial.com (must exist on the custom domain)

MI_MAILING_FROM=no-reply@pixelplaceofficial.com
MI_MAILING_FROM_NAME=Mainline Intelligence
MI_MAILING_REPLY_TO=support@pixelplaceofficial.com
MI_MAILING_NOTIFY_TO=support@pixelplaceofficial.com

MI_MAILING_SMTP_HOST=smtp.mail.me.com
MI_MAILING_SMTP_PORT=587
MI_MAILING_SMTP_USER=yourname@icloud.com
MI_MAILING_SMTP_PASS=xxxx-xxxx-xxxx-xxxx
