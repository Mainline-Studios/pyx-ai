# Mainline Intelligence mailing list (welcome mail from no-reply@…)
# Set these on Cloud Run service pyxaiapi, or in a gitignored repo-root .env

MI_MAILING_FROM=no-reply@pixelplaceofficial.com
MI_MAILING_FROM_NAME=Mainline Intelligence
MI_MAILING_REPLY_TO=support@pixelplaceofficial.com
MI_MAILING_NOTIFY_TO=support@pixelplaceofficial.com

# SMTP that is allowed to send as no-reply@pixelplaceofficial.com
MI_MAILING_SMTP_HOST=smtp.gmail.com
MI_MAILING_SMTP_PORT=465
MI_MAILING_SMTP_USER=no-reply@pixelplaceofficial.com
MI_MAILING_SMTP_PASS=your-app-password-or-smtp-secret

# Optional fallback: if MI_MAILING_SMTP_* unset, code reuses EMAIL_VERIFICATION_SMTP_* /
# PYX_APPLICATION_SMTP_* — but From will still default to no-reply@pixelplaceofficial.com,
# so the SMTP user must be authorized to send as that address.
