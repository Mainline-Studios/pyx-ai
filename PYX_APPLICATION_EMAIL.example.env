# Work with Pyx — decision emails (hired / rejected)
# Copy lines you need into repo-root .env (gitignored) OR set on Cloud Run service pyxaiapi.
# You can reuse the same Gmail app-password vars as Pixel Place — change names/URLs for Pyx.

PYX_APP_PUBLIC_URL=https://pyx-ai.web.app
APP_PUBLIC_URL=https://pyx-ai.web.app

PYX_APPLICATION_FROM_NAME=Pyx AI
EMAIL_VERIFICATION_FROM=boehmlaird@gmail.com
EMAIL_VERIFICATION_SMTP_USER=boehmlaird@gmail.com
EMAIL_VERIFICATION_SMTP_PASS=your-gmail-app-password-no-spaces
EMAIL_VERIFICATION_SMTP_HOST=smtp.gmail.com
EMAIL_VERIFICATION_SMTP_PORT=465
PYX_APPLICATION_REPLY_TO=
