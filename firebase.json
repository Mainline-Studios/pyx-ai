{
  "functions": {
    "source": "functions",
    "runtime": "python310"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "predeploy": ["npm run build:trainer-auth"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.php",
      "pyx-firebase-trainer.html"
    ],
    "headers": [
      {
        "source": "/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/downloads/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/pyx-firebase-trainer.html",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/session/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/score",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/moderator/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/moderator/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mi/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/mi/mailing/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/talk",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/pixel_art",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/code_chat",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/pyx13-preview/chat",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/speak/tts",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/speak/tacotron",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/studio/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/check",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/check/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/health",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/workforpyx.php",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/dev-workshop.php",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/dev-workshop/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/write/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/betas",
        "destination": "/betas/index.html"
      },
      {
        "source": "/betas/pyxassistant",
        "destination": "/betas/pyxassistant/index.html"
      }
    ]
  }
}
