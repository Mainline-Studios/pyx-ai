{
  "functions": {
    "source": "functions",
    "runtime": "python310"
  },
  "hosting": {
    "public": "public",
    "predeploy": ["npm run build:trainer-auth"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/score",
        "function": {
          "functionId": "pyxscore",
          "region": "us-central1"
        }
      }
    ]
  }
}
