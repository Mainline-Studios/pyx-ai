{
  "functions": {
    "source": "functions",
    "runtime": "python310"
  },
  "hosting": {
    "public": "public",
    "predeploy": ["npm run build:trainer-auth"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.php"
    ],
    "headers": [
      {
        "source": "/**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/downloads/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/score",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/talk",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/pixel_art",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/code_chat",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/pyx13-preview/chat",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/speak/tts",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/speak/tacotron",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/studio/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/check",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/check/**",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/health",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/workforpyx.php",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      },
      {
        "source": "/dev-workshop.php",
        "run": {
          "serviceId": "pyxaiapi",
          "region": "us-central1"
        }
      }
    ]
  }
}
