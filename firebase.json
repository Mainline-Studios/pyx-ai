{
  "functions": {
    "source": "functions",
    "runtime": "python310"
  },
  "hosting": {
    "public": "public",
    "predeploy": ["npm run build:trainer-auth"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/score",
        "function": {
          "functionId": "pyxscore",
          "region": "us-central1"
        }
      }
    ]
  }
}
